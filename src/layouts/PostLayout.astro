---
import BaseLayout from './BaseLayout.astro';
import { type Lang, useTranslations, dateLocales } from '../i18n/translations';
import { getLocalePath } from '../i18n/utils';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  lang: Lang;
}

const { title, date, tags = [], lang } = Astro.props;
const t = useTranslations(lang);

const dateStr = date.toLocaleDateString(dateLocales[lang], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} lang={lang}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="post-body">
      <slot />
    </div>

    <footer class="post-footer">
      <a href={getLocalePath('/blog', lang)}>{t('post.back')}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-title {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.1em 0.5em;
    border: 1px solid var(--border);
    border-radius: 3px;
    font-size: 0.75rem;
  }

  .post-body {
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .post-body :global(h2) {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .post-footer a {
    color: var(--text-dim);
  }
</style>
